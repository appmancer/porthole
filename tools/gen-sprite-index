SWATCH_SIZE = 24  # px in the HTML

def swatch_html(hex_color: str) -> str:
    return (f'<span style="display:inline-block;width:{SWATCH_SIZE}px;height:{SWATCH_SIZE}px;'
            f'background:{hex_color};border:1px solid #888;vertical-align:middle;'
            f'margin-right:6px;border-radius:3px;"></span>')

def rgb_to_hex(r: int, g: int, b: int) -> str:
    return f"#{r:02X}{g:02X}{b:02X}"

