# Shown as-is so the designer sees the existing colours.
MODE5_PALETTE = {
    "0": (0,   0,   0),    # black
    "1": (255, 0,   0),    # red
    "2": (0,   255, 255),  # cyan
    "3": (255, 255, 0),    # yellow
    ".": (220, 220, 220),  # transparent shown as light grey
}

# ---------------------------------------------------------------------------
# PNG writer (no external deps)
# ---------------------------------------------------------------------------

def _png_chunk(typ: bytes, data: bytes) -> bytes:
    crc = zlib.crc32(typ)
    crc = zlib.crc32(data, crc) & 0xFFFFFFFF
    return struct.pack(">I", len(data)) + typ + data + struct.pack(">I", crc)

def write_png_rgba(width: int, height: int, buf: bytearray) -> bytes:
    sig = b"\x89PNG\r\n\x1a\n"
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0)
    stride = width * 4
    raw = bytearray()
    for y in range(height):
        raw.append(0)
        raw.extend(buf[y * stride:(y + 1) * stride])
    idat = zlib.compress(bytes(raw), 9)
    return (sig
            + _png_chunk(b"IHDR", ihdr)
            + _png_chunk(b"IDAT", idat)
            + _png_chunk(b"IEND", b""))

def png_to_data_uri(png_bytes: bytes) -> str:
    return "data:image/png;base64," + base64.b64encode(png_bytes).decode()

# ---------------------------------------------------------------------------
# Sprite rendering
# ---------------------------------------------------------------------------

PIXEL_CELL_RE = re.compile(r"^[0-3.]+$")

def pixels_from_line(line: str, max_w: int = 16) -> list[str]:
    tokens: list[str] = []
    for cell in line.split(","):
        cell = cell.strip()
        if not cell or not PIXEL_CELL_RE.match(cell):
            continue
        tokens.extend(list(cell))
        if len(tokens) >= max_w:
            break
    if not tokens:
        return []
    if len(tokens) < max_w:
        tokens += ["."] * (max_w - len(tokens))
    return tokens[:max_w]

def read_blocks(path: Path, max_w: int = 16) -> list[list[list[str]]]:
    blocks: list[list[list[str]]] = []
    current: list[list[str]] = []
    for line in path.read_text().splitlines():
        px = pixels_from_line(line, max_w)
        if not px:
            if current:
                blocks.append(current)
                current = []
        else:
            current.append(px)
    if current:
        blocks.append(current)
    return blocks

def read_tile_blocks(path: Path) -> list[tuple[str, list[list[str]]]]:
    results: list[tuple[str, list[list[str]]]] = []
    current_label = ""
    current: list[list[str]] = []
    for line in path.read_text().splitlines():
        stripped = line.strip()
        # Tile label rows start with T followed by digits
        if re.match(r"T\d+", stripped):
            if current:
                results.append((current_label, current))
                current = []
            parts = stripped.split(None, 1)
            current_label = parts[0] if parts else ""
            continue
        tokens: list[str] = []
        for cell in line.split(","):
            cell = cell.strip()
            if not cell or not PIXEL_CELL_RE.match(cell):
                continue
            tokens.extend(list(cell))
        if not tokens:
            if current:
                results.append((current_label, current))
                current = []
            continue
        if len(tokens) < 8:
            tokens += ["."] * (8 - len(tokens))
        current.append(tokens[:8])
    if current:
        results.append((current_label, current))
    return results

def render_sprite(block: list[list[str]], scale_x: int, scale_y: int) -> bytes:
    """Render a pixel block to a PNG bytes object."""
    rows = len(block)
    cols = len(block[0]) if block else 16
    w = cols * scale_x
    h = rows * scale_y
    buf = bytearray(w * h * 4)
    for ry, row in enumerate(block):
        for rx, ch in enumerate(row):
            r, g, b = MODE5_PALETTE.get(ch, (255, 0, 255))
            a = 80 if ch == "." else 255
            for sy in range(scale_y):
                for sx in range(scale_x):
                    px = rx * scale_x + sx
                    py = ry * scale_y + sy
                    o = (py * w + px) * 4
                    buf[o] = r; buf[o+1] = g; buf[o+2] = b; buf[o+3] = a
    return write_png_rgba(w, h, buf)

def sprite_uri(block: list[list[str]], scale_x: int = 8, scale_y: int = 4) -> str:
    return png_to_data_uri(render_sprite(block, scale_x, scale_y))

