def build_tech_section() -> str:
    html = section("Technical Constraints")
    html += ("<div class=\"callout\">"
             "<strong>Pixel aspect ratio: 2 : 1 (wide).</strong> "
             "BBC Micro MODE 2 pixels are twice as wide as they are tall on real hardware. "
             "The sprite images in this document are already rendered at 2:1 — "
             "what you see here is how sprites look on screen. "
             "Design your art to look correct at this ratio; "
             "do not draw in a square-pixel tool and submit without checking aspect.</div>\n")
    html += ("<p>The pixel grid for each sprite category:</p>"
             "<ul style='margin:8px 0 16px 24px;color:#ccc;'>"
             "<li><strong>Character sprites (Chell, objects):</strong> "
             "12 logical pixels wide &times; 24–32 pixels tall. "
             "The data slot is 16 px wide; the rightmost 4 px are a shift-expansion zone "
             "auto-generated by the build tools — keep visible content within the first 12 px.</li>"
             "<li><strong>Portal sprites:</strong> 8 px wide (vertical wall portals) "
             "or 16 px wide (horizontal / front-facing).</li>"
             "<li><strong>Tiles:</strong> 8 logical pixels wide &times; 16 pixels tall "
             "(one character cell wide, two cells tall).</li>"
             "<li><strong>Subpixel pre-shifting:</strong> the engine pre-generates four "
             "sub-character-cell variants (x0–x3) from each base sprite by shifting 0–3 px "
             "right. These are synthesised automatically; you supply only the base frame.</li>"
             "</ul>\n")
    html += ("<p><strong>Delivery format:</strong> PNG with a transparent background, "
             "using only the exact hex colours listed above. "
             "Alternatively, the project's CSV pixel-grid format (0/1/2/3 per pixel, "
             ". for transparent) — ask the developer for a template.</p>\n")
    return html

def build_sprite_table(sprites: list[tuple]) -> str:
    html = "<table>\n<tr><th>ID</th><th>Layer</th><th>Description</th><th>Dimensions (logical px)</th><th>Current sprite</th></tr>\n"
    for sid, desc, fg_bg, csv_rel, block_idx, max_w in sprites:
        csv_path = BASE / csv_rel
        badge = f'<span class="badge-fg">FG</span>' if fg_bg == "FG" else f'<span class="badge-bg">BG</span>'
        if csv_path.exists():
            blocks = read_blocks(csv_path, max_w)
            if block_idx < len(blocks):
                block = blocks[block_idx]
                h_px = len(block)
                w_px = max_w
                img_uri = sprite_uri(block, scale_x=8, scale_y=4)
                img_tag = f'<img class="sprite-img" src="{img_uri}" width="{w_px*8}" height="{h_px*4}" alt="{sid}">'
                dims = f"{w_px}&thinsp;&times;&thinsp;{h_px}&thinsp;px"
            else:
                img_tag = "<em style='color:#666'>block not found</em>"
                dims = "—"
        else:
            img_tag = "<em style='color:#666'>file missing</em>"
            dims = "—"
        html += (f"<tr>"
                 f"<td class='sprite-id'>{sid}</td>"
                 f"<td>{badge}</td>"
                 f"<td class='sprite-desc'>{desc}</td>"
                 f"<td class='sprite-dims'>{dims}</td>"
                 f"<td>{img_tag}</td>"
                 f"</tr>\n")
    html += "</table>\n"
    return html

def build_tile_grid(tiles: list[tuple[str, list[list[str]]]]) -> str:
    html = "<div class=\"tile-grid\">\n"
    for label, block in tiles:
        desc_text, fg_bg = TILE_DESCRIPTIONS.get(label, (label, "BG"))
        badge = f'<span class="badge-fg">FG</span>' if fg_bg == "FG" else f'<span class="badge-bg">BG</span>'
        h_px = len(block)
        w_px = 8
        img_uri = sprite_uri(block, scale_x=8, scale_y=4)
        html += (f'<div class="tile-card">'
                 f'<img class="sprite-img" src="{img_uri}" '
                 f'width="{w_px*8}" height="{h_px*4}" alt="{label}">'
                 f'<div class="tile-id">{label} {badge}</div>'
                 f'<div class="tile-desc">{desc_text}</div>'
                 f'</div>\n')
    html += "</div>\n"
    return html

def build_document() -> str:
    parts = [f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PORTHOLE — Sprite Index for Design Brief</title>
<style>{CSS}</style>
</head>
<body>
<h1>PORTHOLE</h1>
<p class="subtitle">Sprite &amp; Tile Index — Graphics Designer Brief</p>
<p>PORTHOLE is a 2D platformer demake of Valve&rsquo;s <em>Portal</em>, running on the
BBC Master 128 — an 8-bit British home computer from 1986. This document lists every
sprite and tile in the game with its function, layer assignment, and current artwork.
All images in this document are rendered at the correct 2:1 pixel aspect ratio as they
appear on real hardware.</p>
"""]

    parts.append(build_palette_section())
    parts.append(build_tech_section())

    # Foreground sprites
    parts.append(section("Foreground Sprites"))
    parts.append("<p>Foreground sprites composite over the tile background using the split-nibble "
                 "OR technique. They use the FG sub-palette (3 colours + transparent). "
                 "Left-facing variants are auto-generated by horizontal flip at runtime.</p>\n")

    parts.append(subsection("Chell — Player Character"))
    chell = [s for s in SPRITE_CATALOGUE if s[0].startswith("CHELL_")]
    parts.append(build_sprite_table(chell))

    parts.append(subsection("Overlays — Portal Gun Arm &amp; Reticle"))
    parts.append("<p>These sprites are composited over the Chell body. They share the same "
                 "16&thinsp;&times;&thinsp;16&thinsp;px canvas and align to the torso.</p>\n")
    overlays = [s for s in SPRITE_CATALOGUE if s[0].startswith("OVERLAY_") or s[0].startswith("RETICLE_")]
    parts.append(build_sprite_table(overlays))

    parts.append(subsection("Portals"))
    parts.append("<p>Portals appear in pairs (red and yellow). Vertical portals sit on walls; "
                 "horizontal portals sit on floors and ceilings; the front-facing &ldquo;big&rdquo; "
                 "portal is what the player walks through.</p>\n")
    portals = [s for s in SPRITE_CATALOGUE if s[0].startswith("PORTAL_")]
    parts.append(build_sprite_table(portals))

    parts.append(subsection("Objects"))
    parts.append("<p>Movable in-game objects. The companion cube can be carried and used to press "
                 "pressure pads. The sentry turret is an enemy that can also be picked up and moved.</p>\n")
    objects = [s for s in SPRITE_CATALOGUE if s[0].startswith("OBJ_")]
    parts.append(build_sprite_table(objects))

    # Background tiles
    parts.append(section("Background Tiles"))
    parts.append("<p>Tiles are static and compose the room geometry. They are drawn once per frame "
                 "from the tilemap and use the BG sub-palette. Each tile is "
                 "8&thinsp;&times;&thinsp;16 logical pixels. Tiles shown here at 2:1 aspect ratio.</p>\n")

    tile_csv = BASE / "sprites" / "NewTiles - Grid.csv"
    tiles = read_tile_blocks(tile_csv)
    parts.append(build_tile_grid(tiles))

    parts.append("</body>\n</html>\n")
    return "".join(parts)

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", default="docs/sprite_index.html", help="Output HTML path")
    args = parser.parse_args()

    out = BASE / args.out
    out.parent.mkdir(parents=True, exist_ok=True)
    html = build_document()
    out.write_text(html, encoding="utf-8")
    size_kb = len(html.encode()) // 1024
    print(f"Sprite index: {out}  ({size_kb} KB)")

if __name__ == "__main__":
    main()
