#!/usr/bin/env python3
"""Add a file to a DFS disk image manually (workaround for beebasm PUTFILE bugs)."""

import struct
import sys

def add_file_to_dfs(ssd_path, source_path, dfs_name, load_addr, exec_addr):
    """Add a file to a DFS disk image."""
    # Read the disk image
    with open(ssd_path, 'rb') as f:
        disk = bytearray(f.read())
    
    # Ensure disk is exactly 200KB first (zero-pad if needed)
    if len(disk) < 204800:
        disk.extend([0] * (204800 - len(disk)))
    elif len(disk) > 204800:
        disk = disk[:204800]
    
    # Read the source file
    with open(source_path, 'rb') as f:
        file_data = f.read()
    
    file_len = len(file_data)
    sectors_needed = (file_len + 255) // 256
    
    # Parse current catalog - count ACTUAL valid files (dir='$'), not what byte 0x105 says
    # (beebasm v1.11 creates a bogus entry 0 with dir='E')
    num_files = 0
    for i in range(31):
        if disk[i*8] == 0:
            break
        if disk[i*8 + 7] == ord('$'):  # Only count entries with valid directory
            num_files += 1
    
    # Find first free sector (scan existing files)
    used_sectors = set()
    for i in range(num_files):
        cat2_base = 0x100 + i * 8
        flen_lo = struct.unpack('<H', disk[cat2_base+4:cat2_base+6])[0]
        attrs = disk[cat2_base+6]
        flen_hi = (attrs >> 4) & 0x3
        flen = (flen_hi << 16) | flen_lo
        start_lo = disk[cat2_base+7]
        start_hi = attrs & 0x3
        start_sec = (start_hi << 8) | start_lo
        fsectors = (flen + 255) // 256
        for s in range(start_sec, start_sec + fsectors):
            used_sectors.add(s)
    
    # Find first free sector after catalog (sector 2)
    start_sector = 2
    while start_sector in used_sectors:
        start_sector += 1
    
    # Check if file already exists
    for i in range(num_files):
        base = i * 8
        fname = disk[base:base+7].decode('ascii', errors='ignore').rstrip()
        if fname == dfs_name[:7]:
            print(f"File {dfs_name} already exists, replacing...", file=sys.stderr)
            # Remove old file entry (just leave it, we'll overwrite catalog entry)
            file_index = i
            break
    else:
        # Add new file
        file_index = num_files
        num_files += 1
        disk[0x105] = num_files * 8
    
    # Write filename in catalog (first 8 bytes of entry)
    base = file_index * 8
    fname_bytes = dfs_name[:7].upper().ljust(7).encode('ascii')
    disk[base:base+7] = fname_bytes
    disk[base+7] = ord('$')  # directory
    
    # Write file info in catalog (8 bytes starting at 0x100 + index*8)
    cat2_base = 0x100 + file_index * 8
    
    load_lo = load_addr & 0xFFFF
    load_hi = (load_addr >> 16) & 0x3
    exec_lo = exec_addr & 0xFFFF
    exec_hi = (exec_addr >> 16) & 0x3
    len_lo = file_len & 0xFFFF
    len_hi = (file_len >> 16) & 0x3
    start_lo = start_sector & 0xFF
    start_hi = (start_sector >> 8) & 0x3
    
    attrs = (exec_hi << 6) | (len_hi << 4) | (load_hi << 2) | start_hi
    
    disk[cat2_base:cat2_base+2] = struct.pack('<H', load_lo)
    disk[cat2_base+2:cat2_base+4] = struct.pack('<H', exec_lo)
    disk[cat2_base+4:cat2_base+6] = struct.pack('<H', len_lo)
    disk[cat2_base+6] = attrs
    disk[cat2_base+7] = start_lo
    
    # Write file data
    offset = start_sector * 256
    disk[offset:offset+file_len] = file_data
    
    # Write back (disk already padded to 200KB at start of function)
    with open(ssd_path, 'wb') as f:
        f.write(disk)
    
    print(f"Added {dfs_name}: {file_len} bytes at sector {start_sector}")

if __name__ == '__main__':
    if len(sys.argv) != 6:
        print(f"Usage: {sys.argv[0]} <ssd_file> <source_file> <dfs_name> <load_addr_hex> <exec_addr_hex>")
        print(f"Example: {sys.argv[0]} game.ssd data.bin MYFILE 0x3000 0x3000")
        sys.exit(1)
    
    ssd_file = sys.argv[1]
    source_file = sys.argv[2]
    dfs_name = sys.argv[3]
    load_addr = int(sys.argv[4], 16) if sys.argv[4].startswith('0x') else int(sys.argv[4])
    exec_addr = int(sys.argv[5], 16) if sys.argv[5].startswith('0x') else int(sys.argv[5])
    
    add_file_to_dfs(ssd_file, source_file, dfs_name, load_addr, exec_addr)
