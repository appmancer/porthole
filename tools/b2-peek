#!/usr/bin/env bash
set -euo pipefail

B2_HOST="${B2_HOST:-127.0.0.1}"
B2_PORT="${B2_PORT:-48075}"
B2_ID="${B2_ID:-b2}"

if [[ $# -lt 2 || $# -gt 3 ]]; then
  echo "Usage: $0 <addr> <len> [suffix]" >&2
  echo "  addr: hex (e.g. 0x2000 or 2000)" >&2
  echo "  len : bytes (e.g. 16, 0x100)" >&2
  echo "  suffix: optional B2 view suffix (e.g. m, o, i)" >&2
  exit 2
fi

addr="$1"
len="$2"
suffix="${3:-}"

addr="${addr#0x}"
len="${len#0x}"

url="http://${B2_HOST}:${B2_PORT}/peek/${B2_ID}/${addr}/+${len}"
if [[ -n "${suffix}" ]]; then
  url+="?s=${suffix}"
fi

curl -s "${url}" | hexdump -C
