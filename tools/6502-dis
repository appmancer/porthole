#!/usr/bin/env python3
"""Minimal 6502 disassembler helper.

This is intentionally lightweight: it is good for first-pass reverse
engineering of BBC Micro binaries extracted from DFS images.

Features:
- Disassembles a range (or whole file) assuming a base load address.
- Decodes a useful subset of 6502 instructions (control-flow + common loads/stores).
- Annotates MOS calls (JSR $FFxx) and common I/O ranges ($FExx).

It is not a full recursive-flow disassembler; treat output as a guide.
"""

from __future__ import annotations

import argparse
import pathlib


