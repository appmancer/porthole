#!/usr/bin/env python3
"""DFS catalogue lister (Acorn DFS 0.90/1.2 style).

Usage:
  tools/dfs-cat path/to/disc.ssd

Notes:
- Assumes a single-sided 200KB DFS image (80 tracks * 10 sectors * 256 bytes).
- Reads catalogue from sectors 0 and 1.
- Prints directory, filename, locked flag, load/exec/length, start sector.
"""

from __future__ import annotations

import argparse
import os
import struct
import sys
from dataclasses import dataclass


SECTOR_SIZE = 256
CAT_SECTORS = 2
CATALOGUE_SIZE = SECTOR_SIZE * CAT_SECTORS


@dataclass(frozen=True)
class DFSEntry:
    directory: str
    name: str
    locked: bool
    load: int
    exec: int
    length: int
    start_sector: int

    @property
    def full_name(self) -> str:
        return f"{self.directory}.{self.name}"


def _read_u16_le(b: bytes) -> int:
    return struct.unpack("<H", b)[0]


def parse_catalogue(image: bytes) -> list[DFSEntry]:
    if len(image) < CATALOGUE_SIZE:
        raise ValueError("Image too small for DFS catalogue")

    cat = image[:CATALOGUE_SIZE]
    header_count = cat[0x105] & 0x1F

    # Some discs have a bogus header count; fall back to scanning the name table.
    scanned_count = 0
    for i in range(31):
        nraw = cat[0x008 + 8 * i : 0x008 + 8 * i + 8]
        if nraw.rstrip(b" \x00") == b"":
            break
        scanned_count += 1

    file_count = scanned_count or header_count

    entries: list[DFSEntry] = []
    for i in range(file_count):
        # Names live at 0x008.. (first 8 bytes are disk title).
        # Two formats exist in the wild:
        # - Classic DFS: 7-char name + directory (bit7=locked).
        # - Some images (including SpyCat here): 7-char name + 1-byte attribute.
        nraw = cat[0x008 + 8 * i : 0x008 + 8 * i + 8]
        nd = nraw.decode("latin1")

        dir_chars = "$0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"

        # Default: assume name+attr, directory "$".
        directory = "$"
        name = nd[0:7].rstrip(" ")
        attr = nd[7]
        locked = (ord(attr) & 0x80) != 0 or attr == "\xa4"

        # Classic DFS images store directory as the 8th byte (often with lock bit).
        dir8 = chr(ord(nd[7]) & 0x7F)
        if dir8 in dir_chars:
            directory = dir8
            name = nd[0:7].rstrip(" ")
            locked = (ord(nd[7]) & 0x80) != 0

        # Some catalogues store directory as the first byte instead.
        dir0 = chr(ord(nd[0]) & 0x7F)
        if dir0 in dir_chars and dir8 not in dir_chars:
            directory = dir0
            name = nd[1:8].rstrip(" ")
            locked = (ord(nd[0]) & 0x80) != 0

        # Metadata lives at 0x108.. in the second catalogue sector.
        m = cat[0x108 + 8 * i : 0x108 + 8 * i + 8]

        load_lo = _read_u16_le(m[0:2])
        exec_lo = _read_u16_le(m[2:4])
        len_lo = _read_u16_le(m[4:6])

        def _bounds_ok(start_sector: int, length: int) -> bool:
            start = start_sector * SECTOR_SIZE
            end = start + length
            return end <= len(image)

        # Common 40-track discs use a simple layout:
        # - 16-bit length
        # - 8-bit start sector
        # - load/exec high nibbles packed into m[6]
        load_b = load_lo | ((m[6] & 0x0F) << 16)
        exec_b = exec_lo | (((m[6] >> 4) & 0x0F) << 16)
        start_sector_b = m[7]
        length_b = len_lo

        # Standard DFS packs high bits into m[6].
        load_a = load_lo | ((m[6] & 0x03) << 16)
        exec_a = exec_lo | (((m[6] >> 2) & 0x03) << 16)
        length_a = len_lo | (((m[6] >> 4) & 0x03) << 16)
        start_sector_a = m[7] | (((m[6] >> 6) & 0x03) << 8)

        if _bounds_ok(start_sector_b, length_b):
            load = load_b
            exec_addr = exec_b
            start_sector = start_sector_b
            length = length_b
        elif _bounds_ok(start_sector_a, length_a):
            load = load_a
            exec_addr = exec_a
            start_sector = start_sector_a
            length = length_a
        else:
            # Fall back to 16-bit length and raw start byte.
            load = load_b
            exec_addr = exec_b
            start_sector = start_sector_b
            length = length_b

        entries.append(
            DFSEntry(
                directory=directory,
                name=name,
                locked=locked,
                load=load,
                exec=exec_addr,
                length=length,
                start_sector=start_sector,
            )
        )

    return entries


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("image", help="Path to DFS .ssd image")
    args = ap.parse_args(argv)

    with open(args.image, "rb") as f:
        image = f.read()

    entries = parse_catalogue(image)

    print(f"image={args.image}")
    print(f"size={len(image)}")
    print("")
    print("idx  file       lock   load     exec     length   start")
    for idx, e in enumerate(entries):
        lock = "L" if e.locked else "-"
        print(
            f"{idx:>3}  {e.full_name:<9} {lock:>4}  {e.load:06X}  {e.exec:06X}  {e.length:6d}  {e.start_sector:5d}"
        )

    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
