#!/usr/bin/env python3
"""DFS file extractor (Acorn DFS 0.90/1.2 style).

Usage:
  tools/dfs-extract path/to/disc.ssd <D.NAME> <out.bin>

Example:
  tools/dfs-extract Disc041-Spycat.ssd !.BOOT .tmp/spycat/BOOT.bin

Notes:
- Assumes file data is stored in 256-byte sectors.
- Uses start sector + length from the DFS catalogue.
- For learning/reverse engineering, we preserve raw bytes only.
"""

from __future__ import annotations

import argparse
import os
import sys


SECTOR_SIZE = 256
CATALOGUE_SIZE = 512


def _read_u16_le(b: bytes) -> int:
    return b[0] | (b[1] << 8)


def _parse_entries(image: bytes):
    if len(image) < CATALOGUE_SIZE:
        raise ValueError("Image too small for DFS catalogue")

    cat = image[:CATALOGUE_SIZE]
    header_count = cat[0x105] & 0x1F

    scanned_count = 0
    for i in range(31):
        nraw = cat[0x008 + 8 * i : 0x008 + 8 * i + 8]
        if nraw.rstrip(b" \x00") == b"":
            break
        scanned_count += 1

    file_count = scanned_count or header_count

    entries = []
    for i in range(file_count):
        nraw = cat[0x008 + 8 * i : 0x008 + 8 * i + 8]
        nd = nraw.decode("latin1")

        dir_chars = "$0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"

        # Default: assume name+attr, directory "$".
        directory = "$"
        name = nd[0:7].rstrip(" ")

        # Classic DFS images store directory as the 8th byte (often with lock bit).
        dir8 = chr(ord(nd[7]) & 0x7F)
        if dir8 in dir_chars:
            directory = dir8
            name = nd[0:7].rstrip(" ")

        # Some catalogues store directory as the first byte instead.
        dir0 = chr(ord(nd[0]) & 0x7F)
        if dir0 in dir_chars and dir8 not in dir_chars:
            directory = dir0
            name = nd[1:8].rstrip(" ")

        m = cat[0x108 + 8 * i : 0x108 + 8 * i + 8]

        length_lo = _read_u16_le(m[4:6])

        # Prefer the 40-track/nibble-layout when it fits within the image.
        start_sector_b = m[7]
        length_b = length_lo

        start_sector_a = m[7] | (((m[6] >> 6) & 0x03) << 8)
        length_a = length_lo | (((m[6] >> 4) & 0x03) << 16)

        def _bounds_ok(start_sector: int, length: int) -> bool:
            start = start_sector * SECTOR_SIZE
            end = start + length
            return end <= len(image)

        if _bounds_ok(start_sector_b, length_b):
            start_sector = start_sector_b
            length = length_b
        elif _bounds_ok(start_sector_a, length_a):
            start_sector = start_sector_a
            length = length_a
        else:
            start_sector = start_sector_b
            length = length_b

        entries.append((f"{directory}.{name}", start_sector, length))

    return entries


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("image", help="Path to DFS .ssd image")
    ap.add_argument("dfs_name", help="DFS filename like S.PYCAT or !.BOOT")
    ap.add_argument("out", help="Output file path")
    args = ap.parse_args(argv)

    with open(args.image, "rb") as f:
        image = f.read()

    entries = _parse_entries(image)
    wanted = args.dfs_name

    def _norm(n: str) -> str:
        return "".join(ch for ch in n if ch not in ("\x00", " "))

    wanted_norm = _norm(wanted)

    match = None
    for fullname, start_sector, length in entries:
        if _norm(fullname) == wanted_norm:
            match = (fullname, start_sector, length)
            break

    if match is None:
        print(f"Not found: {wanted}", file=sys.stderr)
        print("Available:", file=sys.stderr)
        for fullname, start_sector, length in entries:
            print(f"  {fullname}  start={start_sector} len={length}", file=sys.stderr)
        print("\nTip: names often have padded spaces; paste from dfs-cat output.", file=sys.stderr)
        return 2

    fullname, start_sector, length = match
    start = start_sector * SECTOR_SIZE
    end = start + length

    if end > len(image):
        raise ValueError(
            f"File {fullname} overruns image: start={start} length={length} image={len(image)}"
        )

    os.makedirs(os.path.dirname(args.out) or ".", exist_ok=True)
    with open(args.out, "wb") as f:
        f.write(image[start:end])

    print(
        f"extracted {fullname}: start_sector={start_sector} start=0x{start:05X} length={length} -> {args.out}"
    )

    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
