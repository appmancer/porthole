#!/usr/bin/env python3
"""Generate beebasm EQUB sprite+mask data from sprite CSVs.

Input format:
- CSV contains one or more blocks separated by blank rows.
- Each non-blank row's first 16 pixels are taken from the row text:
  - '.' means transparent
  - '0'..'3' means MODE 5 colour index

Notes:
- Many of our sprite CSVs contain extra computed columns (hex bytes, formulas).
  We ignore everything after the first 16 pixel values.
- This parser is intentionally resilient to merged cells (e.g. "10" meaning "1","0").

Supported block sizes:
- 16 rows: 16x16 sprite (2 stripes)
- 32 rows: 16x32 sprite (4 stripes)

Variants:
- '@N' on a spec prefix requests N output variants (x0..xN-1).
- '@N/S' spaces those variants S pixels apart, e.g. '@2/2' emits x0 and x2 only.
- '%N/S' does the same vertically, e.g. '%4/2' emits y0,y2,y4,y6 (3 stripes each).
  (for sprites that only ever sit on even pixel columns).
- A single 16x32 block auto-synthesizes x0..x3 by shifting right 0..3 pixels.
- If N exceeds the number of authored blocks, the blocks are cycled across the
  shift positions: out[i] = blocks[i % len(blocks)] shifted right by i.

Output format:
- Emits Spycat/MODE5 "screen byte order": stripes x (4 columns x 8 rows).
- Emits both sprite pixels and mask bytes (dst = (dst & mask) | pix).

Example:
  ./tools/gen-sprites \
    --out-sprites sprites/generated_chell_sprites.asm \
    --out-masks sprites/generated_chell_masks.asm \
    --spec chell_pos1:"sprites/Chell Position 1 - Sheet3.csv" \
    --spec chell_pos2:"sprites/Chell Position 2 - Sheet3.csv"

Flipping:
  Add a trailing '^' to the prefix in --spec to flip horizontally.
  Example: --spec chell_run_l1^:"sprites/Chell Run Right - Frame 1.csv"

If --prefix is omitted, one is derived from the filename.
"""

from __future__ import annotations

import argparse
import re
from dataclasses import dataclass
from pathlib import Path


@dataclass(frozen=True)
class InputSpec:
    path: Path
    prefix: str
    flip_x: bool = False
    # If set, limits how many blocks/variants to emit for this spec.
    # Useful to suppress auto-synthesized x1..x3 variants for sprites that don't
    # need subpixel shifts.
    variants: int | None = None
    # Pixel distance between consecutive subpixel variants. Default 1 (x0..x3).
    # Use 2 when the sprite only ever sits on even pixel columns, so only
    # offsets 0 and 2 are ever needed.
    step: int = 1
    # Shift vertically instead of horizontally. Variants are labelled _yN and
    # each block is padded to the next multiple of 8 rows, so a 16-row sprite
    # drawn at a non-zero row offset spans three 8-row stripes instead of two.
    vertical: bool = False


def derive_prefix(path: Path) -> str:
    name = path.stem.lower()
    # Common Chell naming.
    name = name.replace("chell position 1", "chell_pos1")
    name = name.replace("chell position 2", "chell_pos2")

    # Collapse to identifier-ish.
    name = re.sub(r"[^a-z0-9]+", "_", name).strip("_")
    if not name:
        raise ValueError(f"cannot derive prefix from filename: {path}")
    if name[0].isdigit():
        name = f"sprite_{name}"
    return name


PIXEL_CELL_RE = re.compile(r"^[0-3.]+$")

def parse_pixel(ch: str, *, path: Path, block_index: int, row_index: int, col_index: int) -> int | None:
    if ch == ".":
        return None
    value = ord(ch) - ord("0")
    if not (0 <= value <= 3):
        raise ValueError(
            f"{path}: block {block_index}, row {row_index + 1}, col {col_index + 1}: value {value} out of range (0..3)"
        )
    return value


def pixels_from_line(line: str, *, path: Path, line_index: int) -> list[str]:
    """Extract the first 16 pixel tokens from a CSV line.

    We parse comma-separated cells and only consider cells that contain pixel
    tokens (0..3 or '.') so computed columns like hex bytes (e.g. "08", "FF")
    don't get misread as pixels.

    Merged spreadsheet cells like "10" still decode as two pixels.
    """

    tokens: list[str] = []
    for cell in line.split(","):
        cell = cell.strip()
        if not cell:
            continue
        if not PIXEL_CELL_RE.match(cell):
            continue
        tokens.extend(list(cell))
    if not tokens:
        return []
    if len(tokens) < 16:
        tokens = tokens + ["."] * (16 - len(tokens))
    return tokens[:16]


def pack_sprite_byte(pixels4: list[int | None]) -> int:
    values = [0 if v is None else v for v in pixels4]
    msb = [(v >> 1) & 1 for v in values]
    lsb = [v & 1 for v in values]

    hi = (msb[0] << 3) | (msb[1] << 2) | (msb[2] << 1) | msb[3]
    lo = (lsb[0] << 3) | (lsb[1] << 2) | (lsb[2] << 1) | lsb[3]
    return (hi << 4) | lo


def pack_mask_byte(pixels4: list[int | None]) -> int:
    # 0xFF keeps background; clear the two bits for each opaque pixel.
    mask = 0xFF
    if pixels4[0] is not None:
        mask -= 0x88
    if pixels4[1] is not None:
        mask -= 0x44
    if pixels4[2] is not None:
        mask -= 0x22
    if pixels4[3] is not None:
        mask -= 0x11
    return mask


def to_spycat_order(raster_bytes: list[int], *, rows: int) -> list[int]:
    if rows % 8 != 0:
        raise ValueError(f"rows must be a multiple of 8, got {rows}")

    expected = rows * 4
    if len(raster_bytes) != expected:
        raise ValueError(f"expected {expected} bytes for {rows} rows, got {len(raster_bytes)}")

    stripes = rows // 8
    out: list[int] = []
    for stripe in range(stripes):
        base_row = stripe * 8
        for col in range(4):
            for row in range(8):
                out.append(raster_bytes[(base_row + row) * 4 + col])
    return out


def shift_block(block: list[list[str]], shift: int) -> list[list[str]]:
    if shift < 0 or shift > 15:
        raise ValueError(f"shift out of range: {shift}")
    if shift == 0:
        return [row[:] for row in block]
    out: list[list[str]] = []
    for row in block:
        out.append(["."] * shift + row[: 16 - shift])
    return out


def vshift_block(block: list[list[str]], shift: int) -> list[list[str]]:
    """Push a block down by `shift` rows, padding to a multiple of 8 rows.

    BBC screen memory is organised in 8-row stripes, so a sprite drawn at a
    row offset that is not a multiple of 8 straddles one more stripe than it
    otherwise would. Padding here means the runtime blitter just asks for one
    extra stripe rather than doing any shifting itself.
    """
    if shift < 0:
        raise ValueError(f"vertical shift out of range: {shift}")
    width = len(block[0]) if block else 16
    blank = ["."] * width
    if shift == 0:
        out = [row[:] for row in block]
    else:
        out = [blank[:] for _ in range(shift)] + [row[:] for row in block]
    total = ((len(out) + 7) // 8) * 8
    out += [blank[:] for _ in range(total - len(out))]
    return out


def read_blocks(path: Path) -> list[list[list[str]]]:
    blocks: list[list[list[str]]] = []
    current: list[list[str]] = []

    lines = path.read_text().splitlines()
    for line_index, line in enumerate(lines):
        pixels = pixels_from_line(line, path=path, line_index=line_index)
        if not pixels:
            if current:
                blocks.append(current)
                current = []
            continue

        current.append(pixels)

    if current:
        blocks.append(current)

    for i, b in enumerate(blocks):
        if len(b) not in (16, 32):
            raise ValueError(f"{path}: block {i} has {len(b)} rows (expected 16 or 32)")

    # Overlay CSVs sometimes include a leading 16x32 "reference" block (composited
    # sprite for visual checking) followed by four 16-row overlay blocks (x0..x3).
    # We don't use the reference at runtime, so drop it to save CHDATA space.
    if (
        len(blocks) == 5
        and len(blocks[0]) == 32
        and all(len(b) == 16 for b in blocks[1:])
    ):
        blocks = blocks[1:]

    return blocks


def limit_or_synthesize_blocks(blocks: list[list[list[str]]], *, variants: int | None, step: int = 1, vertical: bool = False) -> list[list[list[str]]]:
    # Convenience: if a 16x32 sprite only provides a single reference block,
    # synthesize x0..x3 variants by shifting right by 0..3 pixels.
    # This keeps the movement pipeline (subpixel_offset 0..3) working without
    # requiring artists to export four separate blocks.
    if len(blocks) == 1 and len(blocks[0]) == 32:
        n = 4 if variants is None else variants
        if n < 1:
            raise ValueError(f"variants must be >= 1, got {n}")
        if n == 1:
            return blocks
        shifter = vshift_block if vertical else shift_block
        return [shifter(blocks[0], i * step) for i in range(n)]

    if variants is None:
        return blocks
    if variants < 1:
        raise ValueError(f"variants must be >= 1, got {variants}")

    # Cycle the authored blocks across the subpixel positions, so e.g. two spark
    # shapes alternate over the emitted offsets. This keeps one sprite per offset
    # (not shapes x offsets) while making the shape change as the sprite moves.
    # Only engaged when more variants are asked for than authored, or when a
    # non-default step is requested -- otherwise blocks are passed through as-is.
    if variants > len(blocks) or step != 1 or vertical:
        shifter = vshift_block if vertical else shift_block
        return [shifter(blocks[i % len(blocks)], i * step) for i in range(variants)]

    return blocks[:variants]

    return blocks


def generate_for_input(spec: InputSpec) -> tuple[list[tuple[str, list[int]]], list[tuple[str, list[int]]]]:
    blocks = read_blocks(spec.path)
    blocks = limit_or_synthesize_blocks(blocks, variants=spec.variants, step=spec.step, vertical=spec.vertical)

    sprites_out: list[tuple[str, list[int]]] = []
    masks_out: list[tuple[str, list[int]]] = []

    for block_index, block in enumerate(blocks):
        rows = len(block)
        raster_sprite: list[int] = []
        raster_mask: list[int] = []

        for row_index, row in enumerate(block):
            pixels = [
                parse_pixel(row[col], path=spec.path, block_index=block_index, row_index=row_index, col_index=col)
                for col in range(16)
            ]

            if spec.flip_x:
                pixels = list(reversed(pixels))

            for byte_col in range(4):
                group = pixels[byte_col * 4 : byte_col * 4 + 4]
                raster_sprite.append(pack_sprite_byte(group))
                raster_mask.append(pack_mask_byte(group))

        sprite_bytes = to_spycat_order(raster_sprite, rows=rows)
        mask_bytes = to_spycat_order(raster_mask, rows=rows)

        out_index = block_index
        if spec.flip_x:
            # Reversing block order matches subpixel phase when mirroring.
            out_index = (len(blocks) - 1) - block_index

        # Label by true pixel offset so runtime indexing matches the shift.
        axis = "y" if spec.vertical else "x"
        label = f"{spec.prefix}_{axis}{out_index * spec.step}"
        sprites_out.append((label, sprite_bytes))
        masks_out.append((label, mask_bytes))

    return sprites_out, masks_out


def format_eqb(label: str, data: list[int]) -> str:
    lines = [f".{label}"]
    for i in range(0, len(data), 16):
        chunk = data[i : i + 16]
        lines.append("    EQUB " + ",".join(f"&{b:02X}" for b in chunk))
    lines.append("")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description="Generate beebasm EQUB sprite+mask data from CSVs")
    parser.add_argument(
        "--out-sprites",
        default="sprites/generated_chell_sprites.asm",
        help="Output .asm file containing sprite pixel data",
    )
    parser.add_argument(
        "--out-masks",
        default="sprites/generated_chell_masks.asm",
        help="Output .asm file containing sprite mask data",
    )

    parser.add_argument(
        "--spec",
        action="append",
        default=[],
        help="Input spec PREFIX:PATH (repeatable)",
    )
    parser.add_argument(
        "--prefix",
        action="append",
        default=[],
        help="Prefixes for positional inputs (must match count)",
    )
    parser.add_argument(
        "inputs",
        nargs="*",
        help="Input CSV files (each may contain multiple 32-row blocks)",
    )

    args = parser.parse_args()

    specs: list[InputSpec] = []

    def parse_prefix_modifiers(prefix_text: str) -> tuple[str, bool, int | None, int, bool]:
        # Supported modifiers (order-independent):
        # - '^'   : flip horizontally
        # - '@N'  : limit variants/blocks emitted
        # - '@N/S': N variants spaced S pixels apart (default S=1)
        # - '%N/S': as @N/S but shifting vertically, labelled _yN
        flip_x = "^" in prefix_text
        prefix_text = prefix_text.replace("^", "")

        vertical = "%" in prefix_text
        if vertical:
            if "@" in prefix_text:
                raise SystemExit(f"invalid prefix '{prefix_text}' (use either @ or %, not both)")
            prefix_text = prefix_text.replace("%", "@", 1)

        variants: int | None = None
        step = 1
        if "@" in prefix_text:
            base, n_text = prefix_text.rsplit("@", 1)
            if not n_text:
                raise SystemExit(f"invalid prefix '{prefix_text}' (expected @N or @N/S)")
            step_text = "1"
            if "/" in n_text:
                n_text, step_text = n_text.split("/", 1)
            try:
                variants = int(n_text)
                step = int(step_text)
            except ValueError:
                raise SystemExit(f"invalid prefix '{prefix_text}' (expected @N or @N/S, integers)")
            if step < 1:
                raise SystemExit(f"invalid step in '{prefix_text}' (must be >= 1)")
            prefix_text = base

        prefix_text = prefix_text.strip()
        if not prefix_text:
            raise SystemExit("empty prefix")
        return prefix_text, flip_x, variants, step, vertical

    if args.spec:
        if args.inputs:
            raise SystemExit("use either --spec or positional inputs, not both")
        if args.prefix:
            raise SystemExit("--prefix is not used with --spec")

        for spec_text in args.spec:
            if ":" not in spec_text:
                raise SystemExit(f"invalid --spec '{spec_text}' (expected PREFIX:PATH)")
            prefix, path_text = spec_text.split(":", 1)

            prefix, flip_x, variants, step, vertical = parse_prefix_modifiers(prefix)
            specs.append(InputSpec(path=Path(path_text), prefix=prefix, flip_x=flip_x, variants=variants, step=step, vertical=vertical))
    else:
        if not args.inputs:
            raise SystemExit("no inputs provided")

        input_paths = [Path(p) for p in args.inputs]
        if args.prefix and len(args.prefix) != len(input_paths):
            raise SystemExit("--prefix count must match number of input files")

        for i, path in enumerate(input_paths):
            prefix = args.prefix[i] if args.prefix else derive_prefix(path)

            prefix, flip_x, variants, step, vertical = parse_prefix_modifiers(prefix)
            specs.append(InputSpec(path=path, prefix=prefix, flip_x=flip_x, variants=variants, step=step, vertical=vertical))

    all_sprite_blocks: list[tuple[str, list[int]]] = []
    all_mask_blocks: list[tuple[str, list[int]]] = []

    for spec in specs:
        sprite_blocks, mask_blocks = generate_for_input(spec)
        all_sprite_blocks.extend(sprite_blocks)
        all_mask_blocks.extend(mask_blocks)

    out_sprites = Path(args.out_sprites)
    out_masks = Path(args.out_masks)

    out_sprites.parent.mkdir(parents=True, exist_ok=True)
    out_masks.parent.mkdir(parents=True, exist_ok=True)

    header = (
        "; Auto-generated by tools/gen-sprites.\n"
        "; Do not edit by hand.\n"
        "\n"
    )

    sprite_text = header + "".join(format_eqb(label, data) for label, data in all_sprite_blocks)
    mask_text = header + "".join(format_eqb(label + "_mask", data) for label, data in all_mask_blocks)

    out_sprites.write_text(sprite_text)
    out_masks.write_text(mask_text)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
